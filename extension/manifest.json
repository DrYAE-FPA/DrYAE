{
  "manifest_version": 3,
  "name": "DrYAE",
  "version": "1.7.0",
  "description": "__MSG_extDesc__",
  "key": "",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DrYAE",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "default_locale": "en"
}